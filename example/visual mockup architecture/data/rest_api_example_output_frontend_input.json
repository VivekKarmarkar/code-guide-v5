  "layers": [
    {
      "title": "The Basic Request Loop",
      "explanation": "A client talks to a server that reads and writes a database — this is the irreducible skeleton of any REST API. Every other piece in the system exists because this simple loop hits limits at scale or complexity.",
      "nodeIds": [
        "client",
        "gateway",
        "server",
        "db"
      ],
      "edgeIds": [
        "e1-fwd",
        "e1-rev",
        "e2-fwd",
        "e2-rev",
        "e3-fwd",
        "e3-rev"
      ]
    },
    {
      "title": "Who Are You?",
      "explanation": "An auth service sits between the gateway and the database to verify identity before any request touches business logic. Without it, every endpoint is public and anyone can read or mutate anyone else's data.",
      "nodeIds": [
        "client",
        "gateway",
        "server",
        "db",
        "auth"
      ],
      "edgeIds": [
        "e1-fwd",
        "e1-rev",
        "e2-fwd",
        "e2-rev",
        "e3-fwd",
        "e3-rev",
        "e4-fwd",
        "e4-rev",
        "e5-fwd",
        "e5-rev"
      ]
    },
    {
      "title": "Stop Asking the Database the Same Question",
      "explanation": "A Redis cache gives the app server a fast in-memory layer so repeated reads hit RAM instead of disk. The database is the bottleneck in almost every web app, and caching is the cheapest way to relieve it.",
      "nodeIds": [
        "client",
        "gateway",
        "server",
        "db",
        "auth",
        "cache"
      ],
      "edgeIds": [
        "e1-fwd",
        "e1-rev",
        "e2-fwd",
        "e2-rev",
        "e3-fwd",
        "e3-rev",
        "e4-fwd",
        "e4-rev",
        "e5-fwd",
        "e5-rev",
        "e6-fwd",
        "e6-rev"
      ]
    },
    {
      "title": "Do It Later",
      "explanation": "A message queue lets the app server hand off slow work and respond to the client immediately. Sending an email or generating a PDF doesn't need to block a 200ms API response — so we decouple the trigger from the execution.",
      "nodeIds": [
        "client",
        "gateway",
        "server",
        "db",
        "auth",
        "cache",
        "queue",
        "worker"
      ],
      "edgeIds": [
        "e1-fwd",
        "e1-rev",
        "e2-fwd",
        "e2-rev",
        "e3-fwd",
        "e3-rev",
        "e4-fwd",
