        "e5-fwd",
        "e5-rev",
        "e6-fwd",
        "e6-rev",
        "e7",
        "e8",
        "e9-fwd",
        "e9-rev"
      ]
    },
    {
      "title": "The Outside World",
      "explanation": "The background worker connects to an external email provider to actually deliver transactional messages. This is where the system's boundary meets a third-party service it doesn't control, introducing retries and failure handling.",
      "nodeIds": [
        "client",
        "gateway",
        "server",
        "db",
        "auth",
        "cache",
        "queue",
        "worker",
        "email"
      ],
